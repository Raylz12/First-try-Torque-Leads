{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/fullbay.js": { "memory": 256, "maxDuration": 30 },
    "api/shops.js":   { "memory": 128, "maxDuration": 10 },
    "api/auth.js":    { "memory": 128, "maxDuration": 10 }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
